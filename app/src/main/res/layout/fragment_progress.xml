<?xml version="1.0" encoding="utf-8"?>
<!-- FR-23: the whole Progress tab scrolls. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/progress_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp"
        android:paddingTop="10dp">

        <LinearLayout
            android:id="@+id/progress_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progress_spinner"
                style="@android:style/Widget.Material.ProgressBar.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/progress_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:paddingStart="8dp"
                android:text="@string/progress_loading"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- FR-23a summary tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="-4dp"
            android:layout_marginStart="-4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tile_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/card"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/stat_total"
                    style="@style/TileValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="0" />

                <TextView
                    style="@style/TileLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/stat_total" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_week"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/card"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/stat_week"
                    style="@style/TileValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="0" />

                <TextView
                    style="@style/TileLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/stat_last_seven" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="-4dp"
            android:layout_marginStart="-4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tile_streak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/card"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/stat_streak"
                    style="@style/TileValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="0" />

                <TextView
                    style="@style/TileLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/stat_streak" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_exercises"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/card"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/stat_exercises"
                    style="@style/TileValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="0" />

                <TextView
                    style="@style/TileLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/stat_exercises" />
            </LinearLayout>

        </LinearLayout>

        <!-- FR-23b line chart -->

        <TextView
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/chart_weight_title" />

        <Spinner
            android:id="@+id/progress_exercise"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="@string/chart_weight_exercise" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card">

            <com.cs533.workoutlog.ChartView
                android:id="@+id/chart_weight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>

        <!-- FR-23c bar chart -->

        <TextView
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/chart_weekly_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="-4dp"
            android:text="@string/chart_weekly_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card">

            <com.cs533.workoutlog.ChartView
                android:id="@+id/chart_weekly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>

        <!-- FR-23d horizontal bar chart -->

        <TextView
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/chart_volume_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="-4dp"
            android:text="@string/chart_volume_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card">

            <com.cs533.workoutlog.ChartView
                android:id="@+id/chart_volume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>

        <!-- FR-23e personal records -->

        <TextView
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/records_title" />

        <LinearLayout
            android:id="@+id/records_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:divider="@drawable/divider"
            android:orientation="vertical"
            android:showDividers="middle" />

        <TextView
            android:id="@+id/records_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:text="@string/records_empty"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
