<?xml version="1.0" encoding="utf-8"?>
<!-- Selected tab is filled with the brand green; the other tab is a pale outline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/brand" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/card_border" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/brand" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/tab_idle_background" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
